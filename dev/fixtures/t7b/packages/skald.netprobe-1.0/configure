#!/bin/bash
# Runs inside the package's sandbox, at install (T7b probe): what it can reach and see goes
# into the binary, where the probe reads it. A shared binary's install code must reach no
# network and find no credential (WORKPLAN-BUNDLES T7b step 2, point 6).
#
# net: a TCP connect to the RUN's default gateway, its nameservers, 1.1.1.1, and the first 16
# hosts of every on-link subnet (where a worker's egress gateway and the network's bridge
# live: the sandbox is never told the gateway's address), ports 53, 80, 5000 and 8888 (the
# gateway's). "Connection refused" counts as reached: it proves a path to a host, whatever
# listens there (5b80946 N1: a name that only resolves outside the worker proves nothing).
# token_files and registry_auth_files search every mounted filesystem but /proc, /sys and
# /dev (5b80946 N2), for a forge token and for a docker config's "auths" (N3).
mkdir -p inst
targets=$(
  awk 'NR > 1 && $2 == "00000000" { print $3 }' /proc/net/route 2>/dev/null | while read -r h; do
    printf '%d.%d.%d.%d\n' "0x${h:6:2}" "0x${h:4:2}" "0x${h:2:2}" "0x${h:0:2}"
  done
  awk '$1 == "nameserver" { print $2 }' /etc/resolv.conf 2>/dev/null
  echo 1.1.1.1
  awk 'NR > 1 && $1 != "lo" && $2 != "00000000" { print $2, $8 }' /proc/net/route 2>/dev/null |
    while read -r d m; do
      net=$(( 0x${d:6:2} << 24 | 0x${d:4:2} << 16 | 0x${d:2:2} << 8 | 0x${d:0:2} ))
      for i in $(seq 1 16); do
        a=$(( net + i ))
        printf '%d.%d.%d.%d\n' $(( a >> 24 & 255 )) $(( a >> 16 & 255 )) $(( a >> 8 & 255 )) $(( a & 255 ))
      done
    done
)
reached=unreachable
for ip in $targets; do
  for port in 53 80 5000 8888; do
    err=$(timeout 1 bash -c "exec 3<>/dev/tcp/$ip/$port" 2>&1) && { reached="reached:$ip:$port"; break 2; }
    case "$err" in *refused*) reached="reached:$ip:$port(refused)"; break 2 ;; esac
  done
done
search() {
  find / \( -path /proc -o -path /sys -o -path /dev \) -prune -o -type f -size -2M -print 2>/dev/null |
    grep -v '/probe.txt$' | xargs -r grep -lsE "$1" 2>/dev/null | wc -l
}
{
  echo "interfaces=$(awk 'NR > 2 { sub(":", "", $1); printf "%s ", $1 }' /proc/net/dev)"
  echo "net=$reached"
  echo "token_env=$( (cat /proc/[0-9]*/environ 2>/dev/null | tr '\0' '\n'; env) | grep -c 'forge_[0-9a-f]\{64\}')"
  echo "token_files=$(search 'forge_[0-9a-f]{64}')"
  echo "registry_auth_files=$(search '"auths"[[:space:]]*:')"
  echo "uid=$(id -u)"
} > inst/probe.txt
